{
  "name": "wocody/boat-backup",
  "description": "Local WordPress migrations and recoverable restores.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=7.4"},
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}},
  "scripts": {
    "test": "php tests/unit.php",
    "lint": "php tools/lint.php",
    "standards": "phpcs",
    "build": "php tools/build.php"
  }
}
